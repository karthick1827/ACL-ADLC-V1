# ==============================================================================
# ACL-ADLC Markdown Studio - Environment Configuration Template
# Copy this file to '.env' and adjust the paths and credentials for your setup.
# ==============================================================================

# Target project(s) to automatically receive replicated Markdown Studio updates
# (HTML, CSS, JS, API handlers, brand assets). Supports single or comma-separated paths:
# Example (Windows):
# ACL_STUDIO_TARGET_PROJECTS=C:\Users\<username>\Desktop\Projects\my-vite-app
# Example (macOS/Linux):
# ACL_STUDIO_TARGET_PROJECTS=/Users/<username>/Projects/my-vite-app
ACL_STUDIO_TARGET_PROJECTS=

# Primary target project for development server when running `npm run studio:dev`:
# ACL_TARGET_PROJECT=

# (Optional) GitHub Personal Access Token for Cloud Commits via Markdown Studio
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
# GITHUB_OWNER=your-org-or-username
# GITHUB_REPO=your-repo-name
# GITHUB_BRANCH=main

# (Optional) Gmail App Password for sending verification / review emails
# GMAIL_USER=your-email@company.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

